<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>ec2f340f-a44c-4869-ab79-a12ba9459d80</UserSecretsId>
    <AssemblyVersion>0.0.1337</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="Discord.Net" Version="3.20.2" />
    <PackageReference Include="Discord.Net.Commands" Version="3.20.2" />
    <PackageReference Include="Discord.Net.Core" Version="3.20.2" />
    <PackageReference Include="Discord.Net.Interactions" Version="3.20.2" />
    <PackageReference Include="Discord.Net.Rest" Version="3.20.2" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.25" />
    <PackageReference Include="Lavalink4NET" Version="4.2.2" />
    <PackageReference Include="Lavalink4NET.Artwork" Version="4.2.2" />
    <PackageReference Include="Lavalink4NET.Discord.NET" Version="4.2.2" />
    <PackageReference Include="Lavalink4NET.Integrations.Lavasrc" Version="4.2.2" />
    <PackageReference Include="Lavalink4NET.Integrations.SponsorBlock" Version="4.2.2" />
    <!-- MediatR 13+ requires a commercial license. 12.5.0 is the latest Apache-2.0 release. -->
    <PackageReference Include="MediatR" Version="12.5.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="OllamaSharp" Version="5.5.0" />
    <!-- SqlClient pulls Pkcs 9.0.18, which is in the CVE-2026-84008 and CVE-2026-70162 ranges. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.22" />
    <PackageReference Include="Lavalink4NET.Jellyfin" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../docker-compose.yml" pack="true" PackagePath="." />
    <None Include="../application.yml" pack="true" PackagePath="." />
    <None Include="../start-services.sh" pack="true" PackagePath="." />
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
